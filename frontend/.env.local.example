# Copier ce fichier en .env.local pour le développement local

# URL du backend FastAPI (Render en prod, localhost en dev local)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase (même projet pour dev et prod)
NEXT_PUBLIC_SUPABASE_URL=https://zcxaxwqkswuefzlzpgvi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Lien d'invitation Skool du groupe privé (missions + stratégies d'acquisition).
# À poser sur le BACKEND Render (`SKOOL_INVITE_URL`), pas ici : le front le
# lit via GET /pilote/invite après inscription. Absent ⇒ pas de bouton
# « Rejoindre le groupe privé » sur l'écran de succès.
#
# Google : pas de variable ici. À activer dans Supabase Auth → Providers → Google
# (Client ID + secret Google Cloud). Redirect URI côté Google =
# https://zcxaxwqkswuefzlzpgvi.supabase.co/auth/v1/callback
# Redirect URLs côté Supabase : http://localhost:3000/pilote
# + le domaine de l'env (dev / cibl.clareo-solutions.fr).
